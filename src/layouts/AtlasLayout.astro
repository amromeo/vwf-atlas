---
import '../styles/atlas.css';
import '../styles/patient-crops.css';
interface Props { title: string; collectionNavigation?: boolean }
const { title, collectionNavigation = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="A source-linked visual reference to von Willebrand factor multimer patterns, with patient and laboratory context." />
    {__ATLAS_REVIEW__ && <meta name="robots" content="noindex, nofollow" />}
    <title>{title} · VWF Atlas</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="brand" href={`${base}/`} aria-label="VWF Atlas home"><span class="brand-symbol" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span><span>VWF <b>ATLAS</b></span></a>
      {collectionNavigation ? <nav class="collection-nav" aria-label="Atlas navigation"><a href="#patient-records">Patient records</a><a href="#featured-example">Featured pattern</a></nav> : <span class="header-description">A visual reference to multimer patterns</span>}
      {__ATLAS_REVIEW__ && <span class="review-pill">Review edition</span>}
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer" id="about">
      <div><strong>VWF Atlas</strong><p>Published evidence. Visible context. Considered interpretation.</p></div>
      <p>Original atlas text and code: CC0.<br />Third-party figures retain their stated licenses.</p>
    </footer>
  </body>
</html>
