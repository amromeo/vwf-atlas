---
// Throwaway question: which atlas homepage hierarchy works best? Three variants on /?variant=.
// Review builds only; retain on the exploration branch until the owner chooses.
import type { AtlasExample } from '../../lib/content';
import PrototypeLanes from './PrototypeLanes.astro';
import PrototypeEvidence from './PrototypeEvidence.astro';
import prototypeStyles from '../../styles/homepage-prototype.css?inline';
import PrototypeSwitcher from './PrototypeSwitcher.astro';
interface Props { entries: AtlasExample[] }
const {entries} = Astro.props;
const ordered = [...entries].sort((a,b) => a.image.crop.patient.x - b.image.crop.patient.x);
const featured = ordered.find(e => e.id === 'casonato-2017-patient-10')!;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const record = (e: AtlasExample) => `${base}/examples/${e.id}/`;
---
<style is:inline set:html={prototypeStyles}/>
<div class="homepage-prototype" data-homepage-prototype>
  <a class="prototype-skip" href="#prototype-main">Skip to atlas</a>
  <div class="prototype-review-note"><strong>Design exploration · public draft</strong><span>Three homepage concepts. All patient records await scientific approval.</span></div>
  <main id="prototype-main">
    <section class="prototype-variant clinical" data-variant="A" aria-label="Clinical reference concept">
      <header class="clinical-header"><a class="prototype-brand" href={`${base}/?variant=A`}>VWF <span>ATLAS</span></a><nav aria-label="Clinical navigation"><a href="#clinical-records">Patient records</a><a href="#clinical-feature">Featured pattern</a></nav><span class="edition-label">Clinical reference / 01</span></header>
      <div class="clinical-layout"><aside class="clinical-sidebar"><p class="prototype-kicker">In this collection</p><h2>Multimer patterns</h2><a href="#clinical-feature" class="active-category">Loss of large multimers <span>5</span></a><p class="prototype-small">Initial collection: five published cases from one study.</p><hr/><p class="prototype-kicker">Read in context</p><p>Every gel is linked to the patient, laboratory findings, assay, and original publication.</p></aside><div class="clinical-main"><div class="clinical-intro"><p class="prototype-kicker">A literature-based visual reference</p><h1>VWF Multimer Atlas</h1><p>Explore multimer patterns with the clinical and laboratory evidence that gives them meaning.</p></div><section id="clinical-records"><div class="prototype-section-label"><h2>Published patient records</h2><span>05 records · 01 source</span></div><div class="prototype-table-wrap"><table class="clinical-records"><thead><tr><th scope="col">Patient</th><th scope="col">Age / sex</th><th scope="col">VWF variant</th><th scope="col">Source</th></tr></thead><tbody>{ordered.map(e => <tr><th scope="row"><a href={record(e)}>{e.patient.label} ↗</a></th><td>{e.patient.age} · {e.patient.sex}</td><td><code>{e.patient.variant}</code></td><td>{e.source.shortCitation}<small>Draft · Figure 1</small></td></tr>)}</tbody></table></div></section><section class="clinical-feature" id="clinical-feature"><p class="prototype-kicker">Featured pattern · {featured.patient.label}</p><h2>{featured.pattern.label}</h2><div class="clinical-feature-grid"><PrototypeLanes entry={featured}/><p>{featured.summary}<br/><a class="prototype-button" href={record(featured)}>Open patient record →</a></p></div><PrototypeEvidence entry={featured}/></section></div></div>
    </section>
    <section class="prototype-variant gallery" data-variant="B" aria-label="Visual gallery concept" hidden>
      <header class="gallery-header"><a class="prototype-brand" href={`${base}/?variant=B`}>VWF <span>ATLAS</span></a><a href="#gallery-records">Explore the collection ↗</a><span class="edition-label">Visual gallery / 02</span></header>
      <div class="gallery-intro"><p class="prototype-kicker">The literature, in view</p><h1>Start with the pattern.<br/><em>Understand the case.</em></h1><p>A visual atlas of von Willebrand factor multimers, grounded in published patient and laboratory evidence.</p><div class="gallery-stats"><span><b>05</b> Patient records</span><span><b>01</b> Source publication</span><span>Draft collection · scientific review pending</span></div></div>
      <section id="gallery-records" class="gallery-collection"><div class="prototype-section-label"><h2>Loss of large multimers</h2><span>Type 2B VWD · source classification</span></div><div class="gallery-grid">{ordered.map(e => <article class="gallery-card"><div class="gallery-card-top"><span>Figure 1 / lane {e.image.crop.patientLane}</span><span>Draft</span></div><a class="gallery-image-link" href={record(e)} aria-label={`Open ${e.patient.label}`}><PrototypeLanes entry={e} scale={0.65}/></a><div class="gallery-card-body"><h3><a href={record(e)}>{e.patient.label} <span>↗</span></a></h3><p>{e.patient.age} · {e.patient.sex} · <code>{e.patient.variant}</code></p><small>{e.source.shortCitation} · Figure 1</small></div></article>)}</div><p class="prototype-small gallery-crop-note">Each card pairs separately cropped patient and normal-plasma lanes from the same source figure. All cases are from one study and one pattern group. Figure 1: Casonato et al. (2017), <a href={featured.rights.url}>CC BY 4.0</a>. These are display windows, not new experimental gels.</p></section>
      <section class="gallery-feature"><div><p class="prototype-kicker">Inside a patient record</p><h2>{featured.patient.label}<br/><em>{featured.pattern.label}</em></h2><p>{featured.summary}</p><a class="prototype-button" href={record(featured)}>Explore the complete record →</a></div><div class="gallery-feature-image"><PrototypeLanes entry={featured}/></div><PrototypeEvidence entry={featured}/></section>
    </section>
    <section class="prototype-variant editorial" data-variant="C" aria-label="Editorial atlas concept" hidden>
      <header class="editorial-header"><a class="prototype-brand" href={`${base}/?variant=C`}>VWF <span>ATLAS</span></a><span>A visual reference to von Willebrand factor</span><span class="edition-label">Editorial atlas / 03</span></header>
      <div class="editorial-title"><p class="prototype-kicker">Published evidence. Patient context.</p><h1>Reading the<br/><em>multimer pattern.</em></h1><p>Explore the patterns of von Willebrand factor through the patients, assays, and publications behind each image.</p></div>
      <section class="editorial-feature"><div class="editorial-feature-text"><p class="prototype-kicker">01 / A closer look</p><h2>{featured.pattern.label}</h2><p>{featured.summary}</p><a class="prototype-button" href={record(featured)}>Read the patient record →</a><div class="editorial-source-tag"><strong>{featured.patient.label} · {featured.patient.variant}</strong><span>{featured.source.shortCitation} · Figure 1</span><span>Draft for scientific review</span></div></div><div class="editorial-plate"><span class="plate-label">Source image / patient &amp; reference</span><PrototypeLanes entry={featured} scale={1}/><p>Separately displayed crop windows.<br/>Same source figure, same vertical scale.</p></div><PrototypeEvidence entry={featured}/></section>
      <section class="editorial-index"><div><p class="prototype-kicker">02 / The collection</p><h2>Five patients.<br/>One source study.</h2><p>Individual records retain the clinical details and laboratory findings reported for each patient.</p></div><ol>{ordered.map(e => <li><a href={record(e)}><span>{e.patient.label}</span><span>{e.patient.age} · {e.patient.sex}</span><code>{e.patient.variant}</code><span aria-hidden="true">↗</span></a><small>{e.source.shortCitation} · Figure 1 · Draft</small></li>)}</ol></section>
    </section>
  </main>
  <footer class="prototype-footer"><p><strong>VWF Multimer Atlas</strong><br/>A growing reference built from published literature.</p><p>Original text and code: CC0.<br/>Source figures retain their stated licenses.</p></footer>
  <PrototypeSwitcher/>
</div>
