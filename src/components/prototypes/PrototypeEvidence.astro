---
import type { AtlasExample } from '../../lib/content';
interface Props { entry: AtlasExample }
const {entry: e} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<section class="prototype-evidence" aria-label="Featured patient evidence">
  <div class="evidence-context"><p class="prototype-kicker">Case context</p><h3>{e.patient.label} · {e.patient.age} · {e.patient.sex}</h3><p>{e.patient.diagnosis}. Variant: <strong>{e.patient.variant}</strong>.</p><p>{e.patient.history}</p><details><summary>Assay &amp; source context</summary><p>{e.assay.method}</p><p>{e.assay.control}</p><p>{e.assay.limitations}</p></details></div>
  <div class="evidence-labs"><p class="prototype-kicker">Laboratory findings</p><div class="prototype-table-wrap"><table><caption>{e.patient.label} · selected source results</caption><thead><tr><th scope="col">Test</th><th scope="col">Result</th><th scope="col">Source reference</th></tr></thead><tbody>{e.labs.filter(row => ['VWF:Ag', 'VWF:CB', 'Platelet count'].includes(row.test)).map(row => <tr><th scope="row">{row.test}</th><td>{row.result} {row.units}</td><td>{row.reference}</td></tr>)}</tbody></table></div><p class="prototype-small">{e.source.table}. Source-specific intervals. <a href={`${base}/examples/${e.id}/`}>All results and patient history →</a></p></div>
  <div class="evidence-source"><p>{e.rights.attribution} <a href={e.rights.url}>{e.rights.label}</a>. Separate crop windows; original scale and lane labels retained.</p><details><summary>Complete source Figure 1</summary><img class="prototype-original" src={`${base}/media/${e.imageName}`} alt={e.image.alt} width={e.image.width} height={e.image.height} /><p>{e.rights.modifications}</p></details><a href={e.source.url}>Read the publication ↗</a></div>
</section>
