<!-- Throwaway review-only switcher. The host page gates this entire component. -->
<nav class="prototype-switcher" aria-label="Design concept switcher"><button type="button" data-cycle="-1" aria-label="Previous concept">←</button><span class="prototype-current" aria-live="polite">A · Clinical reference</span><div class="prototype-options"><a href="?variant=A" data-option="A" aria-label="Concept A: Clinical reference">A</a><a href="?variant=B" data-option="B" aria-label="Concept B: Visual gallery">B</a><a href="?variant=C" data-option="C" aria-label="Concept C: Editorial atlas">C</a></div><button type="button" data-cycle="1" aria-label="Next concept">→</button></nav>
<script is:inline>
(() => {
  const keys = ['A', 'B', 'C'];
  const names = { A: 'Clinical reference', B: 'Visual gallery', C: 'Editorial atlas' };
  function show() {
    const param = new URL(location.href).searchParams.get('variant');
    const key = keys.includes(param) ? param : 'A';
    document.querySelectorAll('[data-variant]').forEach(el => el.hidden = el.dataset.variant !== key);
    document.querySelector('.prototype-current').textContent = `${key} · ${names[key]}`;
    document.querySelectorAll('[data-option]').forEach(el => {if (el.dataset.option === key) el.setAttribute('aria-current', 'true'); else el.removeAttribute('aria-current');});
    document.title = `${names[key]} · VWF Atlas design exploration`;
    document.documentElement.dataset.concept = key;
  }
  function cycle(direction) {
    const key = document.documentElement.dataset.concept;
    const next = keys[(keys.indexOf(key) + direction + keys.length) % keys.length];
    const url = new URL(location.href); url.searchParams.set('variant', next); url.hash = '';
    history.pushState(null, '', url); show(); window.scrollTo(0, 0);
  }
  document.querySelectorAll('[data-cycle]').forEach(el => el.addEventListener('click', () => cycle(Number(el.dataset.cycle))));
  document.querySelectorAll('[data-option]').forEach(el => el.addEventListener('click', event => { event.preventDefault(); const url = new URL(location.href); url.searchParams.set('variant', el.dataset.option); url.hash = ''; history.pushState(null, '', url); show(); window.scrollTo(0, 0); }));
  window.addEventListener('popstate', show);
  window.addEventListener('keydown', event => {
    if (event.defaultPrevented || event.altKey || event.ctrlKey || event.metaKey || event.shiftKey || !(event.target instanceof HTMLElement) || event.target.closest('input,textarea,select,[contenteditable]:not([contenteditable="false"]),[role="textbox"]')) return;
    if (event.key === 'ArrowRight' || event.key === 'ArrowLeft') {event.preventDefault(); cycle(event.key === 'ArrowRight' ? 1 : -1);}
  });
  show();
})();
</script>
