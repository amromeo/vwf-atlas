---
import type { AtlasExample } from '../../lib/content';
interface Props { entry: AtlasExample; scale?: number }
const { entry: e, scale = 0.8 } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const lanes = [
  { rect: e.image.crop.control, title: 'Normal reference', lane: `NP · lane ${e.image.crop.controlLane}` },
  { rect: e.image.crop.patient, title: e.patient.label, lane: `Source lane ${e.image.crop.patientLane}` },
];
---
<div class="prototype-lanes">
  {lanes.map(({rect, title, lane}) => <div class="prototype-lane"><strong>{title}</strong><small>{lane}</small><div class="prototype-crop" style={`width:${rect.width * scale}px;height:${rect.height * scale}px`}><img src={`${base}/media/${e.imageName}`} alt={`${title}, ${lane}, crop from Casonato et al. Figure 1`} width={e.image.width} height={e.image.height} style={`width:${e.image.width * scale}px;height:${e.image.height * scale}px;left:${-rect.x * scale}px;top:${-rect.y * scale}px`} /></div></div>)}
</div>
